function HopServer(bossName)
   local args = {
      [1] = "BlackbeardReward",
      [2] = "2"
   }
   local success, result = pcall(function() return ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args)) end)
   if success and result then
      game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, result, game.Players.LocalPlayer)
   else
      game:GetService("TeleportService"):Teleport(game.PlaceId)
   end
end

