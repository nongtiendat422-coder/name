local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

local enabled = false

-- GUI nhỏ
local gui = Instance.new("ScreenGui", game.CoreGui)
local button = Instance.new("TextButton", gui)

button.Size = UDim2.new(0,120,0,40)
button.Position = UDim2.new(0,10,0.5,0)
button.Text = "VOID KILL OFF"
button.BackgroundColor3 = Color3.fromRGB(30,30,30)
button.TextColor3 = Color3.new(1,1,1)

button.MouseButton1Click:Connect(function()
	enabled = not enabled
	button.Text = enabled and "VOID KILL ON" or "VOID KILL OFF"
end)

-- kích hoạt khi dùng skill
game:GetService("UserInputService").InputBegan:Connect(function(input)
	if not enabled then return end
	
	if input.KeyCode == Enum.KeyCode.V then -- Dough V
		
		local old = hrp.CFrame
		
		-- tp ra void
		hrp.CFrame = CFrame.new(0,-5000,0)
		
		wait(0.1)
		
		-- tp lại vị trí cũ
		hrp.CFrame = old
		
	end
end)
