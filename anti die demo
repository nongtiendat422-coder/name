-- Hàm Teleport chống khống chế và chống kéo lại
local function skyTeleport()
    local character = player.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if humanoidRootPart and humanoid then
            -- Chống khống chế: Đổi state, disable sit/stand
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
            humanoid.Sit = false
            humanoid.PlatformStand = true
            
            -- Tạo BodyPosition để force vị trí mới, chống kéo lại
            local bodyPos = Instance.new("BodyPosition")
            bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bodyPos.Position = humanoidRootPart.Position + Vector3.new(0, 1500, 0)
            bodyPos.Parent = humanoidRootPart
            
            -- Set velocity ban đầu
            humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 500, 0)
            
            -- Tween để mượt mà và chống lag/pull back
            local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(bodyPos, tweenInfo, {Position = bodyPos.Position})
            tween:Play()
            
            -- Đợi tween hoàn thành rồi destroy BodyPosition
            tween.Completed:Wait()
            bodyPos:Destroy()
            
            -- Reset states
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

tpButton.MouseButton1Click:Connect(skyTeleport)

