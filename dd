local frozen = false
local autoAccept = false
local spamVisual = false
local declineBtn = nil
local acceptBtn = nil
local addBtn = nil

local function findButton(parent, keywords)
    for _, obj in pairs(parent:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local nameLower = obj.Name:lower()
            for _, kw in pairs(keywords) do
                if nameLower:find(kw) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function setupTrade(gui)
    declineBtn = findButton(gui, {"decline", "cancel", "no"})
    acceptBtn = findButton(gui, {"accept", "yes", "confirm", "trade"})
    addBtn = findButton(gui, {"add", "plus", "insert"})
end

playerGui.ChildAdded:Connect(function(child)
    if child.Name:lower():find("trade") or child.Name:lower():find("container") then
        wait(0.8)
        setupTrade(child)
    end
end)

FreezeBtn.MouseButton1Click:Connect(function()
    if declineBtn and acceptBtn then
        frozen = true
        declineBtn.Active = false
        declineBtn.Visible = false
        acceptBtn.Active = false
        acceptBtn.Visible = false
    end
end)

UnfreezeBtn.MouseButton1Click:Connect(function()
    if declineBtn and acceptBtn then
        frozen = false
        declineBtn.Active = true
        declineBtn.Visible = true
        acceptBtn.Active = true
        acceptBtn.Visible = true
    end
end)

AutoAcceptToggle.MouseButton1Click:Connect(function()
    autoAccept = not autoAccept
    AutoAcceptToggle.Text = "AUTO ACCEPT: " .. (autoAccept and "ON" or "OFF")
    AutoAcceptToggle.BackgroundColor3 = autoAccept and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 60)
end)

SpamToggle.MouseButton1Click:Connect(function()
    spamVisual = not spamVisual
    SpamToggle.Text = "SPAM ADD VISUAL: " .. (spamVisual and "ON" or "OFF")
    SpamToggle.BackgroundColor3 = spamVisual and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(60, 60, 60)
end)

CloseBtn.MouseButton1Click:Connect(function()
    Frame.Visible = not Frame.Visible
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E then
        FreezeBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.Q then
        UnfreezeBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.Insert then
        Frame.Visible = not Frame.Visible
    end
end)

spawn(function()
    while wait(0.15) do
        if autoAccept and acceptBtn then
            pcall(function()
                acceptBtn.MouseButton1Click:Fire()
            end)
        end
    end
end)

spawn(function()
    while wait(0.08) do
