function FlyFunc(enabled)
   local char = game.Players.LocalPlayer.Character
   if enabled then
      local bg = Instance.new('BodyGyro', char.HumanoidRootPart)
      bg.CFrame = char.HumanoidRootPart.CFrame
      bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
      local bv = Instance.new('BodyVelocity', char.HumanoidRootPart)
      bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
      bv.Velocity = Vector3.new(0, 0.1, 0)
      spawn(function()
         repeat task.wait()
            if not enabled then bg:Destroy() bv:Destroy() return end
            char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 0.1, 0)
         until not char.Parent
      end)
   end
end

